  "design_intents": [
    {
      "decision_template": "PMOS:NMOS width ratio 2:1 (W_P={w_p}um, W_N={w_n}um, L={l_val}um)",
      "reason": "Hole mobility in SKY130 is approximately half electron mobility. Sizing W_P ≈ 2×W_N equalises the pull-up and pull-down drive currents, giving symmetric rise and fall times and a logic threshold near VDD/2.",
      "tradeoffs": "Symmetric sizing maximises noise margins but consumes ~3x the area of a minimum-width inverter.",
      "alternatives": ["Skewed inverter (faster fall, slower rise) for driving NAND inputs", "Minimum-width inverter for area-critical paths"],
      "references": ["CMOS VLSI Design - Weste & Harris Ch.5", "SKY130 Standard Cell Library Documentation"],
      "affected_blocks": ["M_P", "M_N"]
    }
  ],
  "sizing_notes": {
    "M_P": "PMOS pull-up — sized ~2x NMOS width to equalise electron/hole mobility for matched t_pHL / t_pLH.",
    "M_N": "NMOS pull-down — reference width; mobility advantage means it is sized smaller than PMOS."
  },
