  "canonical": "D Latch",
  "name": "D Latch — Level-Sensitive CMOS Latch",
  "description": "Level-sensitive D latch built with a transmission gate and cross-coupled inverter feedback. When EN=1, the latch is transparent: Q follows D. When EN=0, the cross-coupled inverters (M_FB_P, M_FB_N) hold the last sampled value. Half the area of a DFF; used in time-borrowing pipelines and scan chains.",
  "category": "Digital",
  "technology": ["SKY130"],
  "keywords": ["latch", "d latch", "level sensitive", "transparent latch", "level triggered", "data latch"],
  "dynamic": false,
  "dynamic_strategy": null,

  "optimizations": {
    "High Speed": {
      "w_tg":  0.72,
      "w_inv": 0.54,
      "w_fb":  0.36,
      "l_val": 0.15,
      "reasoning": "Wide transmission gate for fast pass; feedback inverters weaker so input can override them on setup."
    },
    "Low Power": {
      "w_tg":  0.36,
      "w_inv": 0.28,
      "w_fb":  0.18,
      "l_val": 0.25,
      "reasoning": "Minimum-width devices for lowest dynamic power."
    },
    "default": {
      "w_tg":  0.54,
      "w_inv": 0.36,
      "w_fb":  0.24,
      "l_val": 0.15,
      "reasoning": "Standard sizing: feedback inverters sized ~2/3 of main inverter to avoid hold-time issues."
    }
  },

