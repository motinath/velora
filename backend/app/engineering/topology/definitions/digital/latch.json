  "design_intents": [
    {
      "decision_template": "Feedback inverter weaker than main inverter (W_FB={w_fb}um vs W_INV={w_inv}um)",
      "reason": "The feedback inverter (M_FB_P/N) must be weaker than the transmission gate drive strength so that new data can successfully overwrite the held state during the transparency window. If feedback is stronger than the input, the latch becomes a storage cell that cannot be written.",
      "tradeoffs": "Weaker feedback reduces hold stability. W_FB ≈ 0.67×W_INV is the standard trade-off for reliable setup-hold timing.",
      "alternatives": ["SR latch (two cross-coupled NOR/NAND)", "Sense-amplifier latch for ADC use"],
      "references": ["SKY130 Latch Timing Analysis", "Static Timing Analysis for Nanometer Designs - Jayaram Bhasker"],
      "affected_blocks": ["M_FB_P", "M_FB_N", "M_TG_P", "M_TG_N"]
    }
  ],
  "sizing_notes": {
    "M_TG_P":  "Transmission gate PMOS — main data pass device.",
    "M_TG_N":  "Transmission gate NMOS — complements PMOS to pass full-swing signal.",
    "M_INV_P": "Main inverter PMOS — produces QN from latch input.",
    "M_FB_P":  "Feedback inverter PMOS — must be weaker than TG to allow data capture."
