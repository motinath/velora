  "design_intents": [
    {
      "decision_template": "Pull-up PMOS sizing (W={w_pu}um, L={l_val}um)",
      "reason": "Sized smaller to reduce subthreshold leakage path to GND and maintain Pull-up Ratio < 1.0 for reliable write overwrite.",
      "tradeoffs": "Smaller PMOS reduces leakage but limits Static Noise Margin (SNM) in read mode.",
      "alternatives": ["Asymmetric driver ratio", "High-Vt implant custom cells"],
      "references": ["SKY130 SRAM Cell Design Guidelines", "JEDEC SRAM Write Ability Standard"],
      "affected_blocks": ["M_PU1", "M_PU2"]
    },
    {
      "decision_template": "Pull-down NMOS sizing (W={w_pd}um, L={l_val}um)",
      "reason": "Sized wider than access transistor to maintain Cell Ratio > 1.2, preventing inadvertent cell flip during read.",
      "tradeoffs": "Larger gate capacitance increases dynamic power vs improved Read Static Noise Margin.",
      "alternatives": ["Symmetrical unit-size driver", "Dual-port dual-WL layout"],
      "references": ["PDK SRAM Cell Stability Rules", "IEEE Trans. Electron Devices - SRAM Scaling"],
      "affected_blocks": ["M_PD1", "M_PD2"]
    },
    {
      "decision_template": "Access NMOS pass-gate sizing (W={w_pg}um, L={l_val}um)",
      "reason": "Sized as a compromise between read stability and write margin — strong enough to pull storage node during write, weak enough not to disturb it during read.",
      "tradeoffs": "Wider access gate improves write speed but degrades read SNM.",
      "alternatives": ["Separate read/write ports (8T topology)", "Asymmetric access transistors"],
      "references": ["Seevinck 6T SRAM Stability Criterion", "SKY130 PDK Design Rules"],
      "affected_blocks": ["M_PG1", "M_PG2"]
    }
  ],

  "sizing_notes": {
    "M_PU1": "Pull-up PMOS — sized small to keep Pull-up Ratio < 1.0 ensuring write overwrite succeeds.",
    "M_PD1": "Pull-down NMOS — sized wider to maintain Cell Ratio > 1.2 preventing inadvertent read flip.",
    "M_PG1": "Access NMOS — sized as a compromise between read stability and write margin."
  },

