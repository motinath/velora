      "l_val": 0.15,
      "w_pd": 0.54,
      "w_pu": 0.36,
      "w_pg": 0.40,
      "reasoning": "Standard SKY130 sizing: Cell Ratio ≈ 1.35, Pull-up Ratio ≈ 0.90 for reliable read stability and write margin."
    }
