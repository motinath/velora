  "design_intents": [
    {
      "decision_template": "Sleep transistor NMOS (W={w_slp}um, L={l_val}um) in pull-down path",
      "reason": "M_SLP1 and M_SLP2 are series-stacked below each pull-down NMOS. When SLP=0 both sleep transistors turn OFF, completely blocking the subthreshold leakage current path to GND in standby.",
      "tradeoffs": "~50% leakage reduction in standby at the cost of ~25% slower write time (two transistors in series must both be ON during write).",
      "alternatives": ["MTCMOS power gating at block level", "High-Vt pull-down transistors"],
      "references": ["Kawasaki et al. 9T SRAM JSSC 2008", "Near-Threshold Computing - Dreslinski"],
