    },
    {
      "decision_template": "Pull-down NMOS series combination sizing (W_PD={w_pd}um, W_SLP={w_slp}um)",
      "reason": "Cell Ratio is computed over the effective series resistance of M_PD1 + M_SLP1. Both transistors must be sized to maintain CR > 1.2 even with sleep transistor ON.",
      "tradeoffs": "Wider M_SLP increases write drive current but also increases standby leakage when SLP=1.",
      "alternatives": ["Separate sleep control per bitcell column"],
      "references": ["9T SRAM Cell Ratio Analysis - ISSCC"],
      "affected_blocks": ["M_PD1", "M_PD2", "M_SLP1", "M_SLP2"]
    }
  ],

  "sizing_notes": {
