  "optimizations": {
    "Low Leakage": {
      "l_val": 0.35, "w_pd": 0.54, "w_pu": 0.36, "w_pg": 0.40, "w_slp": 0.54,
      "reasoning": "Long channel sleep transistors (L=0.35um) maximise off-state resistance; core sized at standard ratios."
    },
    "Ultra Low Power": {
      "l_val": 0.50, "w_pd": 0.42, "w_pu": 0.28, "w_pg": 0.36, "w_slp": 0.42,
      "reasoning": "Near-threshold operation: maximum channel length on all paths cuts both dynamic and leakage power."
    },
    "default": {
      "l_val": 0.25, "w_pd": 0.54, "w_pu": 0.36, "w_pg": 0.40, "w_slp": 0.54,
      "reasoning": "Balanced sizing; sleep transistor sized equal to pull-down to avoid series resistance bottleneck during write."
    }
  },

