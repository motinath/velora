      "l_val": 0.50, "w_pd": 0.54, "w_pu": 0.36, "w_pg": 0.40, "w_rd": 0.36, "w_wa": 0.28,
      "reasoning": "Near-Vt operation. Long channels suppress leakage; write-assist compensates write margin loss at 0.4V VDD."
    },
    "Low Leakage": {
      "l_val": 0.35, "w_pd": 0.60, "w_pu": 0.40, "w_pg": 0.45, "w_rd": 0.42, "w_wa": 0.36,
      "reasoning": "Balanced leakage suppression with sufficient write assist strength."
    },
    "default": {
      "l_val": 0.25, "w_pd": 0.54, "w_pu": 0.36, "w_pg": 0.40, "w_rd": 0.36, "w_wa": 0.28,
      "reasoning": "Standard near-Vt sizing. Write-assist PMOS is weak to avoid contention with pull-up."
    }
  },

