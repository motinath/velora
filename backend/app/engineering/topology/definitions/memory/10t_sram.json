  "design_intents": [
    {
      "decision_template": "Write-assist PMOS (W={w_wa}um, L={l_val}um) on both storage nodes",
      "reason": "At sub-threshold VDD (<0.6V) write margin collapses because the pull-up PMOS cannot be turned fully OFF. M_WA1/M_WA2 are activated (WAE pulled LOW) during write to temporarily boost the node being written HIGH, overcoming this limitation.",
      "tradeoffs": "Write-assist pulse must be precisely timed — too long causes contention; too short provides no benefit. Adds WAE control signal.",
      "alternatives": ["Negative bitline write assist", "Boosted wordline voltage"],
      "references": ["Sinangil et al. 10T SRAM ISSCC 2009", "Sub-Vt SRAM Design Survey - IEEE"],
      "affected_blocks": ["M_WA1", "M_WA2"]
    },
    {
      "decision_template": "Separate read port sizing (W_RD={w_rd}um, L={l_val}um)",
      "reason": "Read disturb is catastrophic at near-Vt because the regenerative latch has no margin to recover. The dedicated read stack (M_RD1 + M_RD2) eliminates this failure mode entirely.",
      "tradeoffs": "Adds RWL and RBL control lines.",
      "alternatives": ["Single-ended 8T (without write assist)", "CAM cell with destructive read"],
      "references": ["8T/10T SRAM Comparison - JSSC 2010"],
      "affected_blocks": ["M_RD1", "M_RD2"]
    }
  ],

  "sizing_notes": {
    "M_WA1": "Write-assist PMOS — activated (gate LOW) during write; pulls the node being written HIGH to overcome near-Vt write margin loss.",
    "M_WA2": "Write-assist PMOS — complementary side; sized weakly to avoid fighting the write-access path.",
    "M_RD1": "Read-access NMOS — isolates storage node during read.",
    "M_RD2": "Read-driver NMOS — gate driven by Q; discharges RBL when Q=1."
  },

