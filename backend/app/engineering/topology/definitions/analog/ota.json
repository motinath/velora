  "name": "Folded Cascode Operational Transconductance Amplifier",
  "description": "Single-stage folded-cascode OTA. The input NMOS differential pair (M_IN1, M_IN2) folds into PMOS cascode devices (M_CP1, M_CP2) loaded by an NMOS cascode mirror (M_CN1, M_CN2, M_CNB1, M_CNB2). Achieves high gain (Av > 60dB) and high output swing simultaneously. Standard choice for ADC reference buffers and filter integrators.",
  "category": "Analog",
  "technology": ["SKY130"],
  "keywords": ["ota", "folded cascode", "folded cascode ota", "operational transconductance", "transconductance amplifier", "opamp"],
  "dynamic": false,
  "dynamic_strategy": null,

  "optimizations": {
