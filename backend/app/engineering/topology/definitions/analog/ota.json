      "w_in": 6.0,
      "w_cp": 4.0,
      "w_cn": 4.0,
      "w_tail": 6.0,
      "l_in": 0.5,
      "l_cp": 1.0,
      "l_cn": 1.0,
      "reasoning": "Long cascode devices maximise ro; input pair sized for maximum gm."
    },
    "High Speed": {
      "w_in": 8.0,
      "w_cp": 4.0,
      "w_cn": 4.0,
      "w_tail": 8.0,
      "l_in": 0.15,
      "l_cp": 0.25,
      "l_cn": 0.25,
      "reasoning": "Minimum length and wide input pair for highest GBW product."
    },
    "default": {
