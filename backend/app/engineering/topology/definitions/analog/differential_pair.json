  "sizing_notes": {
    "M_IN1": "Input NMOS — wider channels maximise gm and thus gain.",
    "M_IN2": "Input NMOS — must match M_IN1 exactly; mismatch creates input-referred offset.",
    "M_L1":  "Diode-connected PMOS load — sets the gate voltage shared with M_L2.",
    "M_L2":  "Mirror PMOS load — replicates M_L1 current into output node, converting differential to single-ended.",
    "M_TAIL":"Tail NMOS current source — biased by V_BIAS; sized twice the input pair width to carry total tail current."
  },

