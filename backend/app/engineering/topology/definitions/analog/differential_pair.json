      "bw_default_mhz": 180.0,
      "optimization_overrides": {
        "High Speed": {"gain_default": 12.0, "bw_default_mhz": 850.0},
        "High Gain":  {"gain_default": 48.0, "bw_default_mhz": 60.0}
      }
    }
  },

  "design_intents": [
    {
      "decision_template": "Input NMOS pair (W={w_in}um, L={l_val}um) — matched",
      "reason": "The transconductance gm of the input pair is the primary gain parameter. Wider channels increase gm and thus voltage gain Av = gm × Rout. Both transistors must be laid out symmetrically to minimise input-referred offset voltage.",
      "tradeoffs": "Wider input pair increases parasitic capacitance, reducing bandwidth. Longer channels increase gain but slow settling.",
      "alternatives": ["PMOS input pair (lower flicker noise)", "Folded cascode input stage"],
      "references": ["Razavi - Design of Analog CMOS ICs Ch.3", "Differential Pair Offset Analysis - Tsividis"],
      "affected_blocks": ["M_IN1", "M_IN2"]
    },
    {
      "decision_template": "Active PMOS mirror load (W={w_load}um, L={l_val}um)",
      "reason": "M_L1 is diode-connected, setting the gate voltage that M_L2 mirrors. This converts the differential current change into a single-ended output at M_L2's drain, doubling the effective transconductance compared to a resistive load.",
      "tradeoffs": "Mirror mismatch between M_L1 and M_L2 introduces systematic output offset. Long L reduces mismatch.",
      "alternatives": ["Resistive load (simpler but lower gain)", "Telescopic cascode load (higher gain)"],
      "references": ["Active Load Differential Pair Analysis", "IEEE JSSC - Mirror Mismatch Effects"],
      "affected_blocks": ["M_L1", "M_L2"]
    },
    {
      "decision_template": "Tail current source NMOS (W={w_tail}um, L={l_val}um)",
      "reason": "Provides a constant high-impedance current source for the differential pair tail. High output resistance suppresses common-mode signals, giving high CMRR.",
      "tradeoffs": "High tail impedance requires adequate headroom (VDS_tail > Vdsat). Reduces output swing.",
      "alternatives": ["Ideal current source", "Resistor tail (lower CMRR)", "Cascode tail (higher CMRR)"],
      "references": ["Analog CMOS ICs Ch.3 - Razavi"],
      "affected_blocks": ["M_TAIL"]
    }
  ],

  "sizing_notes": {
    "M_IN1":  "Input NMOS — wider channels maximise gm and thus gain.",
    "M_IN2":  "Input NMOS — must match M_IN1 exactly; mismatch creates input-referred offset.",
    "M_L1":   "Diode-connected PMOS load — sets the gate voltage shared with M_L2.",
    "M_L2":   "Mirror PMOS load — replicates M_L1 current into output node.",
    "M_TAIL": "Tail NMOS current source — biased by V_BIAS; sized twice the input pair width."
  },

  "kg_nodes": [
    {"id": "Differential Pair",    "type": "Circuit Block",      "description": "Symmetrical transistor pair amplifying difference signals."},
    {"id": "Common Mode Rejection","type": "Metric / Constraint", "description": "Suppression ratio of common-mode noise vs differential signal."},
    {"id": "Active Load",          "type": "Subsystem",          "description": "PMOS mirror configuration acting as high-impedance load."},
    {"id": "Tail Current Source",  "type": "Subsystem",          "description": "NMOS current sink holding total branch current constant."}
  ],
  "kg_edges": [
