{
  "family": "Differential Pair",
  "variant": "Basic",
  "canonical": "Differential Pair",
  "name": "NMOS Differential Pair with Active PMOS Mirror Load",
  "description": "5-transistor differential amplifier. NMOS input pair (M_IN1, M_IN2) amplifies the difference signal. PMOS current mirror load (M_L1 diode-connected, M_L2 mirror) converts differential current to single-ended output. Tail NMOS (M_TAIL) provides high-impedance bias current. Foundation of most OTA and op-amp topologies.",
  "category": "Analog",
  "technology": ["SKY130"],
  "keywords": ["differential pair", "diff pair", "differential amplifier", "opamp input stage", "diff amp", "differential"],
  "dynamic": false,
  "dynamic_strategy": null,

  "optimizations": {
    "Low Leakage": {
      "w_in": 2.0,
      "w_load": 3.0,
      "w_tail": 2.0,
      "l_val": 0.5,
      "reasoning": "Longer channels reduce leakage on all branches while maintaining adequate gm."
    },
    "High Speed": {
      "w_in": 4.0,
      "w_load": 6.0,
      "w_tail": 4.0,
      "l_val": 0.15,
      "reasoning": "Minimum length, wide channels maximise gm and bandwidth."
    },
    "High Gain": {
      "w_in": 5.0,
      "w_load": 4.0,
      "w_tail": 3.0,
      "l_val": 1.0,
      "reasoning": "Long channel lengths increase ro, boosting voltage gain Av = gm·ro."
    },
    "default": {
      "w_in": 2.0,
      "w_load": 3.0,
      "w_tail": 2.0,
      "l_val": 0.25,
      "reasoning": "Symmetric balanced sizing for SKY130."
    }
  },

  "components": [
    {"id": "M_IN1",  "type": "NMOS", "w_key": "w_in",   "l_key": "l_val"},
