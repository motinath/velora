  "design_intents": [
    {
      "decision_template": "StrongARM dynamic latch with reset PMOS (W_RST={w_rst}um)",
      "reason": "Dynamic latch comparator achieves zero static power — the only power consumed is dynamic switching energy per comparison cycle. The regenerative cross-coupled latch amplifies the input voltage difference exponentially, giving sub-ns evaluation times.",
      "tradeoffs": "Input offset is set by M_INP/M_INM mismatch and is random. No static correction. CLK frequency directly trades off against power.",
      "alternatives": ["Pre-amplifier + regenerative latch (lower offset)", "Static differential comparator (higher power)"],
      "references": ["Razavi StrongARM Latch Analysis CICC 2015", "Figueiredo Comparator Survey TCAS-II 2006"],
      "affected_blocks": ["M_RST_P", "M_RST_N", "M_INV_P", "M_INV_P2"]
    }
  ],
  "sizing_notes": {
    "M_INP":  "Input NMOS — differential current imbalance starts regeneration; wider = less input offset.",
    "M_INM":  "Input NMOS — must match M_INP; mismatch is the primary source of random offset.",
    "M_CLK":  "Tail NMOS — enables evaluation on rising CLK.",
    "M_RST_P":"Reset PMOS — resets out_p to VDD on CLK=0."
  },
