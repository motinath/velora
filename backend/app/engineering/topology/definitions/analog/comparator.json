  "sizing_notes": {
    "M_INP":  "Input NMOS — differential current imbalance starts regeneration; wider = less input offset.",
    "M_INM":  "Input NMOS — must match M_INP; mismatch is the primary source of random offset.",
    "M_CLK":  "Tail NMOS — enables evaluation on rising CLK; size for sufficient tail current.",
    "M_RST_P":"Reset PMOS — resets out_p to VDD on CLK=0; must be weak enough not to fight regeneration.",
    "M_RST_N":"Reset PMOS — resets out_m to VDD on CLK=0."
