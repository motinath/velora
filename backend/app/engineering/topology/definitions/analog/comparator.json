  "family": "Comparator",
  "variant": "StrongARM",
  "canonical": "StrongARM Comparator",
  "name": "StrongARM Latch Comparator",
  "description": "Dynamic regenerative comparator based on the StrongARM topology. During the reset phase (CLK=0) M_RST pulls output nodes to VDD. During the evaluation phase (CLK=1) M_CLK enables the tail current, the cross-coupled latch regenerates the input voltage difference to a full-swing digital output. Zero static power. Widely used in ADCs and clock-data recovery circuits.",
  "category": "Analog",
  "technology": ["SKY130"],
  "keywords": ["comparator", "strongarm", "strongarm latch", "dynamic comparator", "latch comparator", "adc comparator", "clocked comparator"],
  "dynamic": false,
  "dynamic_strategy": null,

  "optimizations": {
    "High Speed": {
      "w_in": 4.0,
      "w_inv": 2.0,
      "w_rst": 1.0,
      "w_clk": 3.0,
      "l_val": 0.15,
      "reasoning": "Minimum length and wide input pair maximise regeneration speed; wider tail device reduces evaluation time."
    },
    "Low Power": {
      "w_in": 2.0,
      "w_inv": 1.0,
      "w_rst": 0.5,
      "w_clk": 1.5,
      "l_val": 0.25,
      "reasoning": "Smaller devices reduce dynamic power; clock frequency must compensate for longer evaluation time."
    },
    "default": {
      "w_in": 3.0,
      "w_inv": 1.5,
      "w_rst": 0.72,
      "w_clk": 2.0,
      "l_val": 0.15,
      "reasoning": "Standard trade-off: input offset < 5mV, evaluation time < 200ps at 1.8V."
    }
  },

