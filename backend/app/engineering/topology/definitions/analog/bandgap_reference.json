  "optimizations": {
    "Low Power": {
      "w_op": 2.0,
      "l_op": 1.0,
      "w_cur": 1.5,
      "l_cur": 0.5,
      "reasoning": "Reduced bias current through op-amp and current mirrors to minimise quiescent power."
    },
    "High Precision": {
      "w_op": 5.0,
      "l_op": 2.0,
      "w_cur": 3.0,
      "l_cur": 1.0,
      "reasoning": "Long-channel devices minimise mismatch and 1/f noise; wider input pair reduces offset."
    },
    "default": {
      "w_op": 3.0,
      "l_op": 1.0,
      "w_cur": 2.0,
      "l_cur": 0.5,
      "reasoning": "Balanced precision and quiescent current for standard 1.8V SKY130 supply."
    }
  },

