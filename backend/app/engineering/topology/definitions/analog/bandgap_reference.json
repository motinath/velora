  "simulation": {
    "analysis_type": "operating_point",
    "x_label": "Temperature (°C)",
    "x_step": 5.0,
    "x_points": 80,
    "x_start": -40.0,
    "signals": ["V_REF"],
    "physics": {
      "vref_target_v": 1.205,
      "tc_ppm_per_c_default": 25.0,
      "quiescent_current_ua_default": 12.0,
      "optimization_overrides": {
        "High Precision": {"tc_ppm_per_c_default": 5.0,  "quiescent_current_ua_default": 45.0},
        "Low Power":      {"tc_ppm_per_c_default": 50.0, "quiescent_current_ua_default": 2.5}
      }
    }
  },
  "design_intents": [
    {
      "decision_template": "PTAT and complementary TC summation (W_OP={w_op}um, L_OP={l_op}um)",
      "reason": "The op-amp servo forces equal currents through both branches. Branch1 has a single BJT (Vbe1), branch2 has N BJTs in series (N×Vbe2). The ΔVbe = VT×ln(N) is PTAT (positive TC). Adding ΔVbe to Vbe (negative TC) with the correct weighting resistor ratio cancels the TC to first order at ~1.205V.",
      "tradeoffs": "Second-order curvature causes ~10ppm/°C residual error. Trimming is required for < 5ppm/°C.",
      "alternatives": ["BJT bandgap with external resistors", "Switched-capacitor bandgap for untrimmed < 0.1%"],
      "references": ["Banba et al. CMOS Bandgap JSSC 1999", "Razavi Analog CMOS Ch.11"],
      "affected_blocks": ["M_P1", "M_P2", "M_OP_N1", "M_OP_N2"]
    }
  ],
  "sizing_notes": {
    "M_P1":    "PTAT current source PMOS — channels current through branch1 containing single BJT.",
    "M_P2":    "Reference current PMOS — channels current through branch2 with N:1 BJT stack.",
    "M_OP_P1": "Op-amp PMOS load — servo amplifier forces equal branch currents.",
    "M_TAIL":  "Tail current source — biased by feedback to set op-amp operating point."
  },
  "kg_nodes": [
    {"id": "Bandgap Reference",       "type": "Circuit Block",      "description": "Temperature-stable voltage reference based on semiconductor bandgap energy."},
    {"id": "PTAT Voltage",            "type": "Mechanism",          "description": "Proportional-to-Absolute-Temperature voltage derived from ΔVbe."},
    {"id": "Temperature Coefficient", "type": "Metric / Constraint","description": "Variation of reference voltage with temperature (ppm/°C)."}
  ],
  "kg_edges": [
    {"source": "Bandgap Reference", "relation": "uses",        "target": "PTAT Voltage"},
    {"source": "Bandgap Reference", "relation": "uses",        "target": "Differential Pair"},
    {"source": "Bandgap Reference", "relation": "verified by", "target": "Temperature Coefficient"},
    {"source": "PTAT Voltage",      "relation": "cancels",     "target": "Temperature Coefficient"}
  ]
}
