      {"x1": 500, "y1": 240, "x2": 500, "y2": 320, "net": "mir_source"},
      {"x1": 220, "y1": 360, "x2": 220, "y2": 415, "net": "GND"},
      {"x1": 500, "y1": 360, "x2": 500, "y2": 415, "net": "GND"},
      {"x1": 220, "y1": 415, "x2": 500, "y2": 415, "net": "GND"},
