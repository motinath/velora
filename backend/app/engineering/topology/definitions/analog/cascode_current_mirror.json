    {"comp": "P_VBIAS",    "pin": "IO",  "net": "casc_bias"}
  ],

  "layout": {
    "canvas": {"width": 740, "height": 480},
    "component_positions": {
      "M_REF":      {"x": 220, "y": 340},
      "M_MIR":      {"x": 500, "y": 340},
      "M_CASC_REF": {"x": 220, "y": 220},
      "M_CASC_MIR": {"x": 500, "y": 220},
      "V_VDD":      {"x": 360, "y": 50},
