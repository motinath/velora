      "P_IOUT":     {"x": 500, "y": 110},
      "P_VBIAS":    {"x": 100, "y": 220}
    },
    "wires": [
      {"x1": 220, "y1": 110, "x2": 220, "y2": 200, "net": "gate_net"},
      {"x1": 220, "y1": 150, "x2": 500, "y2": 150, "net": "gate_net"},
      {"x1": 500, "y1": 150, "x2": 500, "y2": 320, "net": "gate_net"},
      {"x1": 100, "y1": 220, "x2": 200, "y2": 220, "net": "casc_bias"},
      {"x1": 200, "y1": 220, "x2": 500, "y2": 220, "net": "casc_bias"},
