      {"x1": 500, "y1": 110, "x2": 500, "y2": 200, "net": "out_net"}
    ]
  },

  "simulation": {
    "analysis_type": "dc_sweep",
    "x_label": "V_DS (V)",
    "x_step": 0.02,
    "x_points": 100,
    "signals": ["I_REF", "I_OUT"],
    "physics": {
      "iref_target_ua": 10.0,
      "lambda_default": 0.04,
      "rout_default_kohm": 5000.0,
      "vsat_v": 0.30,
      "optimization_overrides": {
        "High Precision": {"lambda_default": 0.01, "rout_default_kohm": 12000.0},
        "Low Voltage":    {"lambda_default": 0.08, "rout_default_kohm": 2000.0}
      }
    }
  },

  "design_intents": [
    {
      "decision_template": "Cascode devices M_CASC_REF and M_CASC_MIR (W={w_casc}um, L={l_casc}um)",
      "reason": "The cascode device presents a low-impedance source to the mirror transistor and a high-impedance drain to the output, multiplying the effective output resistance from ro to approximately gm·ro². This reduces the output current variation with VOUT by 10-100x compared to a basic mirror.",
      "tradeoffs": "Requires an additional cascode bias voltage (V_CASC_BIAS) and reduces output voltage swing by one Vdsat.",
      "alternatives": ["Wilson mirror (self-biased cascode)", "Regulated cascode (gain-boosted)"],
      "references": ["Razavi - Design of Analog CMOS ICs Ch.3", "Cascode Mirror Analysis - Tsividis"],
      "affected_blocks": ["M_CASC_REF", "M_CASC_MIR"]
    }
  ],

  "sizing_notes": {
    "M_REF":      "Bottom reference NMOS — diode-connected; sets the gate bias voltage.",
    "M_CASC_REF": "Top cascode on reference side — diode-connected too; sets cascode bias.",
    "M_MIR":      "Bottom mirror NMOS — matched to M_REF.",
    "M_CASC_MIR": "Top cascode on output side — shields M_MIR from VDS variations, multiplying output resistance."
  },

  "kg_nodes": [
    {"id": "Cascode Current Mirror","type": "Circuit Block",       "description": "Four-transistor current mirror with cascode devices for high output impedance."},
    {"id": "Output Impedance",      "type": "Metric / Constraint", "description": "Resistance seen at the output node; higher is better for current source accuracy."}
  ],
  "kg_edges": [
    {"source": "Cascode Current Mirror","relation": "extends",  "target": "Current Mirror"},
    {"source": "Cascode Current Mirror","relation": "improves", "target": "Output Impedance"},
    {"source": "Cascode Current Mirror","relation": "reduces",  "target": "Channel Length Modulation"}
  ]
