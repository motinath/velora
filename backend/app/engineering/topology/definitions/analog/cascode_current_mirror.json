  "name": "Cascode NMOS Current Mirror — High Output Impedance",
  "description": "Four-transistor cascode current mirror. A cascode device (M_CASC_REF, M_CASC_MIR) is stacked above each mirror transistor (M_REF, M_MIR). The cascode shields the mirror transistor from VDS variations, dramatically improving output resistance (r_out ≈ gm·ro²) and current accuracy. Standard choice for precision analog bias circuits.",
  "category": "Analog",
  "technology": ["SKY130"],
  "keywords": ["cascode mirror", "cascode current mirror", "high impedance mirror", "regulated mirror", "precision mirror"],
  "dynamic": false,
  "dynamic_strategy": null,

  "optimizations": {
    "High Precision": {
      "w_val": 4.0,
      "l_val": 1.0,
      "w_casc": 4.0,
      "l_casc": 0.5,
      "reasoning": "Long mirror devices minimise λ; cascode ratio optimised for maximum output resistance."
    },
    "Low Voltage": {
      "w_val": 2.0,
      "l_val": 0.5,
      "w_casc": 2.0,
      "l_casc": 0.25,
      "reasoning": "Shorter cascode maintains headroom at 1.2V supply while preserving most of the impedance benefit."
    },
    "default": {
      "w_val": 2.0,
      "l_val": 0.5,
      "w_casc": 2.0,
      "l_casc": 0.35,
      "reasoning": "Balanced precision/headroom trade-off for 1.8V SKY130 supply."
    }
  },

