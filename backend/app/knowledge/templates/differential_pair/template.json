{
  "design_type": "Differential Pair",
  "name": "Differential Pair basic gain stage",
  "description": "5-transistor active loaded differential amplifier stage with tail bias transistor",
  "optimizations": {
    "Low Leakage": {
      "w_in": 2.0,
      "w_load": 3.0,
      "w_tail": 2.0,
      "l_val": 0.5,
      "reasoning": "Increased channel lengths and optimized input widths to minimize subthreshold leakages."
    },
    "High Speed": {
      "w_in": 4.0,
      "w_load": 6.0,
      "w_tail": 4.0,
      "l_val": 0.15,
      "reasoning": "Sized for maximum transconductance (g_m) at minimum PDK channel length."
    },
    "High Gain": {
      "w_in": 5.0,
      "w_load": 4.0,
      "w_tail": 3.0,
      "l_val": 1.0,
      "reasoning": "Sized with long channel length PMOS/NMOS pairs to increase output resistance (r_o) and voltage gain."
    },
    "default": {
      "w_in": 2.0,
      "w_load": 3.0,
      "w_tail": 2.0,
      "l_val": 0.25,
      "reasoning": "Symmetric common mode sizing parameters applied."
